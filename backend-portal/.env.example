# HRHub Portal Backend — environment configuration
# Copy to .env and fill in values. Shares DATABASE_URL + JWT secrets with the main backend
# so tokens issued by either backend work on both.

NODE_ENV=development
PORT=4001
HOST=0.0.0.0

# Same Neon PostgreSQL connection string as backend/
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# JWT — MUST match backend/.env so tokens are interchangeable
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_to_another_long_random_secret_at_least_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS — comma-separated origins; just the portal frontend
CORS_ORIGINS=http://localhost:5175,https://portal.hrhub.ae

# S3 / MinIO — shared bucket so payslip PDFs etc. resolve the same way
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hrhub
S3_ACCESS_KEY=hrhub_minio
S3_SECRET_KEY=hrhub_minio_secret
S3_PUBLIC_URL=http://localhost:9000/hrhub

# Email — used for password-reset delivery.
#   EMAIL_PROVIDER=gmail   + GMAIL_USER + GMAIL_APP_PASSWORD            (Google App Password)
#   EMAIL_PROVIDER=resend  + RESEND_API_KEY=re_...
#   EMAIL_PROVIDER=smtp    + SMTP_HOST/PORT/USER/PASS                   (SES, Mailpit, etc.)
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@hrhub.ae
EMAIL_FROM_NAME=HRHub Portal
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_DEV_FALLBACK=true

# Public portal URL — used to build reset-password links inside emails.
APP_URL=http://localhost:5175

LOG_LEVEL=info
