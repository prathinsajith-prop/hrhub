# HRHub Portal — frontend environment configuration.
#
# In LOCAL dev: leave VITE_API_URL empty so Vite's dev server proxies /api/v1
# directly to the portal backend on http://localhost:4001 (see vite.config.ts).
#
# In PRODUCTION (Vercel build): set VITE_API_URL to the public origin of your
# backend-portal Railway service, with the /api/v1 suffix included.

# Backend portal API base URL — include the /api/v1 suffix
# Example: https://backend-portal.railway.app/api/v1
VITE_API_URL=

# Admin app URL — shown on the NotAuthorized page when an admin-only account
# tries to sign in to the portal. Defaults to the production admin URL.
VITE_ADMIN_APP_URL=https://hrhub-alpha.vercel.app

# App name shown in page titles & brand mark
VITE_APP_NAME=HRHub Portal
