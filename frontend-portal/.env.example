# HRHub Portal — frontend environment configuration.
#
# ─── DEFAULT (recommended) ────────────────────────────────────────────────
# Leave VITE_API_URL EMPTY in BOTH dev and production.
#
#   • Dev: Vite's dev server proxies /api/v1 → http://localhost:4001
#     (see server.proxy in vite.config.ts)
#   • Prod (Vercel): vercel.json's "rewrites" entry proxies /api/:path*
#     directly to the Railway backend.
#
# This avoids cross-origin requests entirely — no CORS preflights, no chance
# of forgetting the /api/v1 suffix.
#
# ─── OVERRIDE (only if you really need to point at a different backend) ───
# Set VITE_API_URL to the full base WITH the /api/v1 suffix:
#   VITE_API_URL=https://staging-api-portal.example.com/api/v1
# The backend's CORS_ORIGINS must include this frontend's origin in that case.

VITE_API_URL=

# Admin app URL — shown on the NotAuthorized page when an admin-only account
# tries to sign in to the portal. Defaults to the production admin URL.
VITE_ADMIN_APP_URL=https://hrhub-alpha.vercel.app

# App name shown in page titles & brand mark
VITE_APP_NAME=HRHub Portal
